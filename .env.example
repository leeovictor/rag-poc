# ---------------------------------------------------------------------------
# Chave única do OpenRouter (chat + embeddings)
# Obtenha em https://openrouter.ai/keys
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-substitua-pela-sua-chave
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------------------
# Modelos (prefixo de provider é obrigatório no OpenRouter)
# ---------------------------------------------------------------------------
LLM_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=openai/text-embedding-3-small

# Dimensão opcional do embedding (deixe vazio para usar o default do modelo).
# Alterar este valor exige reindexar (rag clear + rag ingest).
EMBEDDING_DIMENSIONS=
EMBEDDING_BATCH_SIZE=64

TEMPERATURE=0

# ---------------------------------------------------------------------------
# Índice / chunking / recuperação
# ---------------------------------------------------------------------------
FAISS_INDEX_DIR=./faiss_index
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=4

# Fan-out: decompõe perguntas compostas em 1..N consultas de busca.
FANOUT_ENABLED=true
FANOUT_MAX_QUERIES=3
FANOUT_CANDIDATES_PER_QUERY=8
# Idioma das consultas geradas: en (base em inglês) ou auto (idioma da pergunta).
FANOUT_QUERY_LANGUAGE=en

# Loop de suficiência: 0 desativa; 1 = uma rodada extra de busca se faltar contexto.
SUFFICIENCY_MAX_ROUNDS=1
# Máximo de consultas de lacuna por rodada.
SUFFICIENCY_MAX_GAP_QUERIES=2

# Turnos de conversa lembrados no chat (0 desativa a memória).
CHAT_MEMORY_TURNS=6

# Links clicáveis nas fontes: vscode | file | none
CITATION_LINK_SCHEME=vscode

# Busca híbrida (FAISS + BM25). Desligue com false para usar apenas vetorial.
HYBRID_SEARCH=true
# Peso do vetorial e do BM25 (normalizados automaticamente).
HYBRID_WEIGHTS=0.5,0.5

# ---------------------------------------------------------------------------
# Atribuição opcional exigida/recomendada pelo OpenRouter
# ---------------------------------------------------------------------------
APP_URL=http://localhost
APP_NAME=rag-poc
